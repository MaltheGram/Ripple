    "keybindings": [
      {
        "command": "ripple.nextUnviewed",
        "key": "alt+n",
        "when": "ripple.active"
      },
      {
        "command": "ripple.markViewedAndNext",
        "key": "alt+shift+n",
        "when": "ripple.active"
      },
      {
        "command": "ripple.ai.explain",
        "key": "alt+e",
        "when": "ripple.active && editorTextFocus"
      },
      {
        "command": "ripple.trace",
        "key": "alt+t",
        "when": "ripple.active && editorTextFocus"
      },
      {
        "command": "ripple.nextThread",
        "key": "alt+u",
        "when": "ripple.active"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ripple.refreshMrs",
          "when": "view == ripple.mrs",
          "group": "navigation@1"
        },
        {
          "command": "ripple.openMr",
          "when": "view == ripple.mrs",
          "group": "navigation@2"
        },
        {
          "command": "ripple.signOut",
          "when": "view == ripple.mrs",
          "group": "more@1"
        },
        {
          "command": "ripple.nextUnviewed",
          "when": "view == ripple.files && ripple.active",
          "group": "navigation@1"
        },
        {
          "command": "ripple.filter",
          "when": "view == ripple.files && ripple.active",
          "group": "navigation@2"
        },
        {
          "command": "ripple.sort",
          "when": "view == ripple.files && ripple.active",
          "group": "navigation@3"
        },
        {
          "command": "ripple.toggleTrivial",
          "when": "view == ripple.files && ripple.active",
          "group": "navigation@4"
        },
        {
          "command": "ripple.submitReview",
          "when": "view == ripple.files && ripple.active",
          "group": "navigation@5"
        },
        {
          "command": "ripple.refresh",
          "when": "view == ripple.files && ripple.active",
          "group": "navigation@6"
        },
        {
          "command": "ripple.markTrivialViewed",
          "when": "view == ripple.files && ripple.active",
          "group": "more@1"
        },
        {
          "command": "ripple.clearFocus",
          "when": "view == ripple.files && ripple.active",
          "group": "more@2"
        },
        {
          "command": "ripple.approve",
          "when": "view == ripple.files && ripple.active",
          "group": "more@3"
        },
        {
          "command": "ripple.unapprove",
          "when": "view == ripple.files && ripple.active",
          "group": "more@4"
        },
        {
          "command": "ripple.openInGitLab",
          "when": "view == ripple.files && ripple.active",
          "group": "more@5"
        },
        {
          "command": "ripple.closeReview",
          "when": "view == ripple.files && ripple.active",
          "group": "more@9"
        },
        {
          "command": "ripple.openOverview",
          "when": "view == ripple.comments",
          "group": "navigation@1"
        },
        {
          "command": "ripple.refresh",
          "when": "view == ripple.comments",
          "group": "navigation@2"
        },
        {
          "command": "ripple.ai.analyze",
          "when": "view == ripple.files && ripple.active",
          "group": "navigation@0"
        },
        {
          "command": "ripple.groupBy",
          "when": "view == ripple.files && ripple.active",
          "group": "more@0"
        },
        {
          "command": "ripple.ai.postSummary",
          "when": "view == ripple.files && ripple.active",
          "group": "more@7"
        },
        {
          "command": "ripple.ai.options",
          "when": "view == ripple.files && ripple.active",
          "group": "more@8"
        },
        {
          "command": "ripple.ai.explain",
          "when": "view == ripple.explain",
          "group": "navigation@1"
        },
        {
          "command": "ripple.ai.explainFile",
          "when": "view == ripple.explain",
          "group": "navigation@2"
        },
        {
          "command": "ripple.explain.clear",
          "when": "view == ripple.explain && ripple.hasExplanations",
          "group": "navigation@3"
        },
        {
          "command": "ripple.crossService.scan",
          "when": "view == ripple.crossService && ripple.crossServiceScanned",
          "group": "navigation@1"
        },
        {
          "command": "ripple.installDependencies",
          "when": "view == ripple.files && ripple.active",
          "group": "more@10"
        },
        {
          "command": "ripple.nextThread",
          "when": "view == ripple.comments",
          "group": "navigation@0"
        },
        {
          "command": "ripple.compareWithVersion",
          "when": "view == ripple.files && ripple.active",
          "group": "more@0"
        },
        {
          "command": "ripple.markReviewed",
          "when": "view == ripple.files && ripple.active",
          "group": "more@0"
        },
        {
          "command": "ripple.gettingStarted",
          "when": "view == ripple.mrs",
          "group": "more@9"
        }
      ],
      "view/item/context": [
        {
          "command": "ripple.focusGroup",
          "when": "view == ripple.files && viewItem == group",
          "group": "inline"
        },
        {
          "command": "ripple.openMrItemInGitLab",
          "when": "view == ripple.mrs && viewItem == mr",
          "group": "inline"
        },
        {
          "command": "ripple.explain.ask",
          "when": "view == ripple.explain && viewItem == explanation",
          "group": "inline@1"
        },
        {
          "command": "ripple.explain.comment",
          "when": "view == ripple.explain && viewItem == explanation",
          "group": "inline@2"
        },
        {
          "command": "ripple.explain.remove",
          "when": "view == ripple.explain && viewItem == explanation",
          "group": "inline@3"
        },
        {
          "command": "ripple.explain.comment",
          "when": "view == ripple.explain && (viewItem == explainEffect || viewItem == explainCheck)",
          "group": "inline@1"
        },
        {
          "command": "ripple.crossService.comment",
          "when": "view == ripple.crossService && viewItem == contractUsed",
          "group": "inline@1"
        },
        {
          "command": "ripple.trace",
          "when": "view == ripple.impact && viewItem == impactSymbol",
          "group": "inline"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "ripple.comment.addDraft",
          "when": "commentController == ripple",
          "group": "inline@1"
        },
        {
          "command": "ripple.comment.postNow",
          "when": "commentController == ripple",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "ripple.comment.resolve",
          "when": "commentController == ripple && commentThread == unresolved",
          "group": "inline"
        },
        {
          "command": "ripple.comment.unresolve",
          "when": "commentController == ripple && commentThread == resolved",
          "group": "inline"
        },
        {
          "command": "ripple.comment.acceptSuggestion",
          "when": "commentController == ripple && commentThread == suggestion",
          "group": "inline@1"
        },
        {
          "command": "ripple.comment.discardSuggestion",
          "when": "commentController == ripple && commentThread == suggestion",
          "group": "inline@2"
        }
      ],
      "comments/comment/title": [
        {
          "command": "ripple.comment.deleteDraft",
          "when": "commentController == ripple && comment == draft",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "ripple.openFile",
          "when": "false"
        },
        {
          "command": "ripple.focusGroup",
          "when": "false"
        },
        {
          "command": "ripple.comment.addDraft",
          "when": "false"
        },
        {
          "command": "ripple.comment.postNow",
          "when": "false"
        },
        {
          "command": "ripple.comment.resolve",
          "when": "false"
        },
        {
          "command": "ripple.comment.unresolve",
          "when": "false"
        },
        {
          "command": "ripple.comment.deleteDraft",
          "when": "false"
        },
        {
          "command": "ripple.reviewMr",
          "when": "false"
        },
        {
          "command": "ripple.openMrItemInGitLab",
          "when": "false"
        },
        {
          "command": "ripple.goToComment",
          "when": "false"
        },
        {
          "command": "ripple.comment.acceptSuggestion",
          "when": "false"
        },
        {
          "command": "ripple.comment.discardSuggestion",
          "when": "false"
        },
        {
          "command": "ripple.revealChange",
          "when": "false"
        },
        {
          "command": "ripple.explain.open",
          "when": "false"
        },
        {
          "command": "ripple.explain.remove",
          "when": "false"
        },
        {
          "command": "ripple.crossService.openContract",
          "when": "false"
        },
        {
          "command": "ripple.crossService.openUsage",
          "when": "false"
        },
        {
          "command": "ripple.crossService.comment",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "ripple.trace",
          "when": "ripple.active && resourceScheme == file",
          "group": "Ripple@0"
        },
        {
          "command": "ripple.ai.explain",
          "when": "ripple.active && (resourceScheme == file || resourceScheme == ripple)",
          "group": "Ripple@1"
        },
        {
          "command": "ripple.ai.suggestComments",
          "when": "ripple.active && resourceScheme == file",
          "group": "Ripple@2"
        },
        {
          "command": "ripple.ai.explainFile",
          "when": "ripple.active && resourceScheme == file",
          "group": "Ripple@3"
        }
      ],
      "editor/title": [
        {
          "command": "ripple.ai.suggestComments",
          "when": "ripple.active && isInDiffEditor && resourceScheme == file",
          "group": "navigation@9"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get started with Ripple",
        "description": "Review GitLab merge requests in VS Code: navigation, focus, traces, comments and optional AI.",
        "steps": [
          {
            "id": "signIn",
            "title": "Sign in to GitLab",
            "description": "Work as yourself: comments, drafts and approvals use your GitLab account.\n[Sign in to GitLab](command:ripple.signIn)",
            "media": {
              "markdown": "media/walkthrough/sign-in.md"
            },
            "completionEvents": [
              "onCommand:ripple.signIn"
            ]
          },
          {
            "id": "openMr",
            "title": "Pick a merge request",
            "description": "Choose an MR from the Merge Requests list; it's checked out without touching your clones.\n[Show Merge Requests](command:workbench.view.extension.ripple)",
            "media": {
              "markdown": "media/walkthrough/open-mr.md"
            },
            "completionEvents": [
              "onContext:ripple.active"
            ]
          },
          {
            "id": "review",
            "title": "Review 200 files without losing focus",
            "description": "Filters, noise detection, suggested order, progress, pipeline and coverage. Alt+N moves to the next unviewed file.\n[Open Next Unviewed File](command:ripple.nextUnviewed)",
            "media": {
              "markdown": "media/walkthrough/review-list.md"
            },
            "completionEvents": [
              "onCommand:ripple.nextUnviewed",
              "onCommand:ripple.markViewedAndNext"
            ]
          },
          {
            "id": "comments",
            "title": "Comment and submit",
            "description": "Drafts, multi-line comments, labels like nit: and q:, Alt+U for the next unresolved thread, then Submit Review.\n[Next Unresolved Thread](command:ripple.nextThread)",
            "media": {
              "markdown": "media/walkthrough/comments.md"
            },
            "completionEvents": [
              "onCommand:ripple.submitReview",
              "onCommand:ripple.comment.addDraft",
              "onCommand:ripple.nextThread"
            ]
          },
          {
            "id": "trace",
            "title": "Trace a changed function",
            "description": "See who calls it and what it calls, across React, HTTP and services. Alt+T at the cursor.\n[Trace Function at Cursor](command:ripple.trace)",
            "media": {
              "markdown": "media/walkthrough/trace.md"
            },
            "completionEvents": [
              "onCommand:ripple.trace"
            ]
          },
          {
            "id": "ai",
            "title": "Explain code and use AI (optional)",
            "description": "Alt+E explains code against the MR. AI review, suggestions and follow-ups use your own Claude login.\n[AI Options](command:ripple.ai.options)",
            "media": {
              "markdown": "media/walkthrough/explain-ai.md"
            },
            "completionEvents": [
              "onCommand:ripple.ai.explain",
              "onCommand:ripple.ai.analyze"
            ]
          },
          {
            "id": "crossService",
            "title": "Cross-service impact",
            "description": "Find other repos using the DTOs, routes and events this MR changes.\n[Scan Cross-service Impact](command:ripple.crossService.scan)",
            "media": {
              "markdown": "media/walkthrough/cross-service.md"
            },
            "completionEvents": [
              "onCommand:ripple.crossService.scan"
            ]
          },
          {
            "id": "tips",
            "title": "Tips",
            "description": "Dependencies for navigation, line history, comparing versions and timings.\n[Open Settings](command:workbench.action.openSettings?%22Ripple%22)",
            "media": {
              "markdown": "media/walkthrough/tips.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.openSettings"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc",
    "test": "vitest run",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies --no-rewrite-relative-links",
    "test:e2e": "npm run build && node test/e2e/run.mjs",
    "test:visual": "npm run build && node test/visual/run.mjs"
  },
  "dependencies": {
    "elkjs": "^0.12.0",
    "minimatch": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  }
}
