{
  "name": "ripple",
  "displayName": "Ripple",
  "description": "Review GitLab merge requests in VS Code with real code navigation, filters, noise detection and focus tools.",
  "version": "0.1.0",
  "publisher": "malthegram",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaltheGram/Ripple.git"
  },
  "bugs": {
    "url": "https://github.com/MaltheGram/Ripple/issues"
  },
  "homepage": "https://github.com/MaltheGram/Ripple#readme",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onAuthenticationRequest:ripple-gitlab"
  ],
  "contributes": {
    "authentication": [
      {
        "id": "ripple-gitlab",
        "label": "GitLab (Ripple)"
      }
    ],
    "configuration": {
      "title": "Ripple",
      "properties": {
        "ripple.gitlab.baseUrl": {
          "type": "string",
          "default": "https://gitlab.com",
          "description": "GitLab instance URL. User settings only (a repository cannot change where your token is sent).",
          "scope": "application"
        },
        "ripple.gitlab.clientId": {
          "type": "string",
          "default": "",
          "description": "Application ID of your GitLab OAuth app (not a secret; see README → Signing in). Empty = sign in with a personal access token. User setting only.",
          "scope": "application"
        },
        "ripple.storageRoot": {
          "type": "string",
          "default": "~/.ripple",
          "description": "Where repo clones and MR worktrees are kept.",
          "scope": "machine"
        },
        "ripple.trivialGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/package-lock.json",
            "**/pnpm-lock.yaml",
            "**/yarn.lock",
            "**/go.sum",
            "**/*.snap",
            "**/__snapshots__/**",
            "**/*.min.js",
            "**/*.generated.*",
            "**/dist/**"
          ],
          "description": "Files matching these globs are marked trivial (noise).",
          "scope": "application"
        },
        "ripple.gitlab.groups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Groups whose open MRs are listed under \"All open in …\" (e.g. [\"acme\"]). Empty = your top-level groups.",
          "scope": "application"
        },
        "ripple.ai.model": {
          "type": "string",
          "default": "sonnet",
          "description": "Default model in the AI options menu (claude --model alias).",
          "scope": "application"
        },
        "ripple.ai.fastModel": {
          "type": "string",
          "default": "haiku",
          "description": "Claude model alias for quick, bulk tasks.",
          "scope": "application"
        },
        "ripple.ai.claudePath": {
          "type": "string",
          "default": "",
          "description": "Path to the Claude Code CLI. Empty = find `claude` on PATH or in common install locations. Machine setting only (a repository cannot change what gets executed).",
          "scope": "machine"
        },
        "ripple.ai.maxInputTokens": {
          "type": "number",
          "default": 30000,
          "minimum": 2000,
          "scope": "application",
          "description": "Default \"Max tokens\" in the AI options menu. Largest diffs are left out first."
        },
        "ripple.hoverHints": {
          "type": "boolean",
          "default": true,
          "description": "On hover over a name whose definition this MR changed, show \"Affected by this MR\" with links to the change and to Explain. Uses the language server only (no AI)."
        },
        "ripple.traceCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show \"Trace callers & callees\" above every function the MR changed."
        },
        "ripple.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Check GitHub Releases once a day for a newer Ripple version and offer to install it."
        },
        "ripple.installDependencies": {
          "type": "string",
          "enum": [
            "ask",
            "never"
          ],
          "default": "ask",
          "description": "Offer (once per project) to install dependencies in the review checkout so go to definition works into node_modules. Never offered for MRs that change package manifests, lockfiles or package-manager config. Lifecycle scripts and pnpm hooks are off."
        },
        "ripple.commentLabels": {
          "type": "boolean",
          "default": true,
          "description": "Expand Conventional Comments shorthands at the start of a comment: nit:, q:, s:, i:, b: (blocking), p:, t:, c: → **nit:** …"
        },
        "ripple.coverage.paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "coverage/{dir}/lcov.info",
            "coverage/lcov.info"
          ],
          "description": "Where to find lcov reports in test jobs' artifacts. {dir} is the app/lib folder the MR touches, e.g. apps/web.",
          "scope": "application"
        },
        "ripple.coverage.decorate": {
          "type": "boolean",
          "default": true,
          "description": "Mark changed lines that no test ran (from the MR pipeline's coverage report) in diffs."
        },
        "ripple.historyHover": {
          "type": "boolean",
          "default": true,
          "description": "Hover a changed line (or an old-side line) to see when the code it replaces last changed, by whom and in which MR (GitLab blame)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ripple",
          "title": "Ripple",
          "icon": "$(git-pull-request)"
        }
      ]
    },
    "views": {
      "ripple": [
        {
          "id": "ripple.mrs",
          "name": "Merge Requests"
        },
        {
          "id": "ripple.files",
          "name": "Review"
        },
        {
          "id": "ripple.explain",
          "name": "Explain",
          "when": "ripple.active"
        },
        {
          "id": "ripple.comments",
          "name": "Comments",
          "when": "ripple.active"
        },
        {
          "id": "ripple.impact",
          "name": "Impact",
          "when": "ripple.active"
        },
        {
          "id": "ripple.crossService",
          "name": "Cross-service",
          "when": "ripple.active"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ripple.mrs",
        "contents": "Sign in to see your merge requests.\n[Sign in to GitLab](command:ripple.signIn)"
      },
      {
        "view": "ripple.files",
        "contents": "Pick a merge request above to start reviewing.\n[Open MR by URL…](command:ripple.openMr)"
      },
      {
        "view": "ripple.explain",
        "contents": "How does this MR affect a piece of code?\nSelect code in a diff or any file of the MR checkout (or put the cursor in a function), then press Alt+E.\n[Explain Selection](command:ripple.ai.explain)\n[Explain Whole File](command:ripple.ai.explainFile)\nEach explanation opens as a document and is listed here."
      },
      {
        "view": "ripple.crossService",
        "contents": "Find other services and repos that use the DTOs, types, API routes and events this MR changes (GitLab code search in your group).\n[Scan Other Repositories](command:ripple.crossService.scan)"
      }
    ],
